<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblContentBackground" />
            <stroke android:width="3dp" android:color="?attr/blblAccent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblContentBackground" />
            <stroke android:width="4dp" android:color="?attr/blblAccent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblContentBackground" />
            <stroke android:width="2dp" android:color="?attr/blblAccent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/blblContentBackground" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
