<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <!-- 正在热播 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_hot_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cinema_hot"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/blblOnPageBackdrop"
                    android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hot"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>

            </LinearLayout>

            <!-- 电影热播 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_movies_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cinema_movies"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/blblOnPageBackdrop"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_movies_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/cinema_filter"
                        android:textSize="12sp"
                        android:textColor="?attr/blblAccent"
                        app:cornerRadius="16dp"
                        app:backgroundTint="?attr/blblContentBackground"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_movies"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>

            </LinearLayout>

            <!-- 电视剧热播 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_tv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cinema_tv"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/blblOnPageBackdrop"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tv_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/cinema_filter"
                        android:textSize="12sp"
                        android:textColor="?attr/blblAccent"
                        app:cornerRadius="16dp"
                        app:backgroundTint="?attr/blblContentBackground"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tv"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>

            </LinearLayout>

            <!-- 纪录片热播 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_documentary_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cinema_documentary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/blblOnPageBackdrop"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_documentary_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/cinema_filter"
                        android:textSize="12sp"
                        android:textColor="?attr/blblAccent"
                        app:cornerRadius="16dp"
                        app:backgroundTint="?attr/blblContentBackground"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_documentary"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>

            </LinearLayout>

            <!-- 综艺热播 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_variety_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cinema_variety"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/blblOnPageBackdrop"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_variety_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/cinema_filter"
                        android:textSize="12sp"
                        android:textColor="?attr/blblAccent"
                        app:cornerRadius="16dp"
                        app:backgroundTint="?attr/blblContentBackground"
                        style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_variety"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
