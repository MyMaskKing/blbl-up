<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 番剧区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvBangumiTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="番剧热播"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/blblOnPageBackdrop"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBangumiFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="筛选"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBangumi"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"/>

            <!-- 国创区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvChineseTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="国创热播"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/blblOnPageBackdrop"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChineseFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="筛选"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChinese"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:clipToPadding="false"/>

        </LinearLayout>

    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
