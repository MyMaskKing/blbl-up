<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/blblPageBackdrop"
    android:padding="16dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilterOptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="重置"
            android:textSize="20sp"
            android:textColor="?attr/blblOnPageBackdrop"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginEnd="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="20sp"
            android:textColor="?attr/blblOnPageBackdropSecondary"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_marginEnd="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="确定"
            android:textSize="20sp"
            android:textColor="?attr/blblAccent"
            app:cornerRadius="12dp"
            app:backgroundTint="?attr/blblContentBackground"/>

    </LinearLayout>

</LinearLayout>
