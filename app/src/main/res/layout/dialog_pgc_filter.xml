<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="?attr/blblPageBackdrop"
    android:padding="16dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFilterOptions"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingEnd="12dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusRight="@id/btnApply"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="140dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/blblFocusBgRound"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/rvFilterOptions"
            android:nextFocusDown="@id/btnReset"
            android:text="确定"
            android:textColor="@color/blbl_button_text_selector"
            android:textSize="20sp"
            android:saveEnabled="false"
            app:cornerRadius="12dp"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="140dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/blblFocusBgRound"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/rvFilterOptions"
            android:nextFocusUp="@id/btnApply"
            android:nextFocusDown="@id/btnCancel"
            android:text="重置"
            android:textColor="@color/blbl_button_text_selector"
            android:textSize="20sp"
            android:saveEnabled="false"
            app:backgroundTint="@null"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="140dp"
            android:layout_height="72dp"
            android:background="?attr/blblFocusBgRound"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/rvFilterOptions"
            android:nextFocusUp="@id/btnReset"
            android:text="取消"
            android:textColor="@color/blbl_button_text_selector"
            android:textSize="20sp"
            android:saveEnabled="false"
            app:backgroundTint="@null"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
